{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    ".next/types/**/*.ts",
    "middleware.ts",
    "next-env.d.ts",
    "next.config.ts",
    "playwright.config.ts",
    "postcss.config.mjs",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tailwind.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    "next-build/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "e2e",
    "next-build",
    "playwright-report",
    "test-results"
  ]
}
